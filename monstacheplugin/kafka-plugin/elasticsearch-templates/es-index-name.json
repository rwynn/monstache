// PUT _index_template/es-index-template

{
  "index_patterns": ["es-index*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "refresh_interval": "30s"
      }
    },
    "mappings": {
      "dynamic": true,
      "numeric_detection": true,
      "date_detection": false,
      "_source": {
        "enabled": true
      },
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      ],
      "properties": {
        "action": {
          "type": "keyword",
          "ignore_above": 256
        },
        "createdAt": {
          "type": "date"
        },
        "status": {
          "type": "keyword",
          "ignore_above": 256
        },
        "type": {
          "type": "keyword",
          "ignore_above": 256
        },
        "updatedAt": {
          "type": "date"
        },
        "id": {
          "type": "keyword",
          "ignore_above": 256
        }
      }
    }
  }
}
