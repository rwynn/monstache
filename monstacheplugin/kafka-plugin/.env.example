# MongoDB Connection
MONGODB_URI="mongodb://localhost:27017/example_db?directConnection=true&serverSelectionTimeoutMS=2000"

# Elasticsearch Configuration
ELASTIC_URL="http://localhost:9200"
ELASTIC_USERNAME="elastic"
ELASTIC_PASSWORD="changeme"
ES_VERSION="8.4.2"

# Kafka Configuration (for plugin dual-sync)
# Set KAFKA_ALLOW_SYNC=false to disable Kafka, sync to ES only
KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC_COLLECTIONS="example_primary,example_related,example_detail"
KAFKA_ALLOW_SYNC="true"